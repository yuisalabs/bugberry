# The client image renders this into /etc/nginx/conf.d/default.conf at start, filling in API_UPSTREAM, MCP_UPSTREAM and
# NGINX_RESOLVER (defaults in docker/client.Dockerfile). Serves the dashboard build and proxies /api to the api.

# Docker's embedded DNS by default. proxy_pass uses a variable, so "api" is resolved per request (cached 10 s):
# nginx starts while the api is still down (502 until it is up) and follows a recreated api's new IP.
resolver ${NGINX_RESOLVER};
resolver_timeout 2s;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml;

    # MCP for AI agents runs in its own container (api-mcp in docker-compose.yml), so agents cannot slow the
    # dashboard down. The longer prefix wins over /api below.
    location ^~ /api/mcp {
        if (-f /etc/nginx/maintenance/maintenance.json) {
            return 503;
        }
        error_page 503 /__maintenance.json;

        set $mcp_upstream ${MCP_UPSTREAM};
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Tool calls are small JSON; uploads go through /api/agent-uploads, served by the api.
        client_max_body_size 1m;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ^~ /api (not /api/) so a bare /api also reaches the api and gets its JSON 404.
    location ^~ /api {
        # Maintenance: while maintenance.json is in /etc/nginx/maintenance (./maintenance in docker-compose.yml),
        # every api request answers 503 with that notice and the dashboard shows its maintenance page. Deleting the
        # file ends it; nginx needs no reload. The api's own 503s still pass through (proxy_intercept_errors is off).
        if (-f /etc/nginx/maintenance/maintenance.json) {
            return 503;
        }
        error_page 503 /__maintenance.json;

        set $api_upstream ${API_UPSTREAM};
        # No URI part: the original path and query are passed through unchanged.
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Appends the address nginx received the request from; the api counts nginx as one hop
        # (PROXY_HOPS=1 in docker-compose.yml), so a value the client wrote is never trusted.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The api enforces MAX_UPLOAD_MB and the upload token's size; nginx streams local uploads to it
        # instead of answering 413 itself or spooling the whole file to its own disk first.
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /__maintenance.json {
        internal;
        alias /etc/nginx/maintenance/maintenance.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    # OAuth discovery for the MCP server (/api/mcp) has to sit at the site root; the api answers it.
    location ^~ /.well-known/oauth- {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /.well-known/openid-configuration {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build output never changes under the same name.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Any other file name (favicon, index.html): the file or a 404, never the app shell.
    location ~ "/[^/]+\.[^/]+$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # A share link's page: the app shell, with the report's preview tags put in by the api, for chat apps that
    # never run the page's JavaScript.
    location ~ "^/s/([A-Za-z0-9_-]{1,64})/?$" {
        set $share_slug $1;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        # The pasted tags say noindex too, but a page whose tags were left out must not be indexed either.
        add_header X-Robots-Tag "noindex" always;
        ssi on;
        ssi_silent_errors on;
        rewrite ^ /index.html break;
    }

    location ^~ /__share_meta/ {
        internal;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/__share_meta/(.+)$ /api/share/$1/meta break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSI can only paste an uncompressed answer.
        proxy_set_header Accept-Encoding "";
        # A slow or stopped api costs the page its preview tags (and at most about 5 s with the resolver's 2), never
        # the page: no answer but a 200 is pasted in.
        proxy_connect_timeout 1s;
        proxy_send_timeout 2s;
        proxy_read_timeout 2s;
        proxy_intercept_errors on;
        error_page 301 302 303 307 308 400 401 403 404 405 408 409 410 413 414 415 422 429 500 501 502 503 504 = @share_meta_empty;
    }

    location @share_meta_empty {
        return 204;
    }

    # Client-side routes (/r/<id>, /s/<slug>, /extension/connect) get the app shell, so a reload works.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}

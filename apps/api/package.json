    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "nodemailer": "10.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bugberry/capture": "workspace:*",
    "@elysiajs/eden": "1.4.9",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11"
  }

PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://fdebag:fdebag@localhost:54329/fdebag
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Encrypts tracker tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Sign-in methods: each is optional, at least one must be on. Redirect URIs (set in each provider):
#   <APP_URL>/api/auth/callback/google   <APP_URL>/api/auth/callback/github   <APP_URL>/api/auth/callback/gitlab
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GitLab.com by default; set GITLAB_URL for a self-hosted GitLab
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.kantor.com
# Email sign-in codes: resend or smtp. Without it, codes are printed to the server log (development only).
# EMAIL_DRIVER=resend
# EMAIL_FROM=BugBerry <no-reply@kantor.com>
# RESEND_API_KEY=
# SMTP_HOST=smtp.kantor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# Unset: anyone can sign up. Set it to limit sign-in to your company domains.
# ALLOWED_EMAIL_DOMAINS=kantor.com
# Chrome extension ID, needed for CORS once the extension exists
EXTENSION_ID=
# Optional: where "New report" sends people to install the extension (an http(s) URL)
# EXTENSION_INSTALL_URL=

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, RustFS)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=fdebag
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_VIRTUAL_HOSTED_STYLE=false

MAX_UPLOAD_MB=300
UPLOAD_URL_TTL_SECONDS=3600
READ_URL_TTL_SECONDS=3600

# BugBerry cloud only: per-account limits (off when unset). Mark exempt accounts with
# `bun run account:unlimited --email someone@example.com --on`.
# ACCOUNT_LIMITS=true
# LIMIT_SCREENSHOTS=5
# LIMIT_RECORDINGS=5
# LIMIT_OWNED_WORKSPACES=1
# LIMIT_STORAGE_MB=250
# LIMIT_FILE_MB=50

# BugBerry cloud only: the marketing pages (/, /pricing, /integrations, /ai-agents, /demo) and the demo form.
# Off: those addresses go to sign-in. DEMO_REQUEST_EMAIL receives each demo request (stored either way).
# PUBLIC_SITE=true
# DEMO_REQUEST_EMAIL=sales@example.com

# Integrations (trackers, notification webhooks) may not reach private network addresses by default, so a shared
# server can't be turned against machines behind it. Self-hosting with an internal GitLab or webhook, or
# trying integrations against localhost in development? Allow them:
# ALLOW_PRIVATE_INTEGRATION_HOSTS=true

# Set to true only when a reverse proxy (e.g. Caddy) sits in front and appends the client IP to X-Forwarded-For
TRUST_PROXY=false
# Set by docker-compose for its nginx; leave unset when running the server directly.
# PROXY_HOPS=0


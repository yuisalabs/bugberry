{
  "name": "@bugberry/extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:opera": "wxt build -b opera",
    "build:e2e": "VITE_SERVER_ORIGIN=http://127.0.0.1:3999 wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:opera": "wxt zip -b opera",
    "key": "bun scripts/extension-key.ts",
    "postinstall": "wxt prepare",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "playwright test",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "sign:firefox": "bun scripts/sign-firefox.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.9",
    "@bugberry/capture": "workspace:*",
    "@bugberry/player": "workspace:*",
    "@bugberry/shared": "workspace:*",
    "@bugberry/ui": "workspace:*",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@remixicon/react": "4.9.0",
    "cn": "0.5.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@bugberry/api": "workspace:*",
    "@happy-dom/global-registrator": "21.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "elysia": "1.4.30",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}

# Production settings for docker-compose.yml. Copy to .env next to it and fill in the blanks:
#   cp .env.docker.example .env
# Generate secrets with: openssl rand -base64 32

# Public address of the dashboard. https is required outside localhost (Google OAuth and the extension).
APP_URL=https://bugberry.kantor.com
# The BUGBERRY_* settings below were called FDEBAG_* before; an existing .env with the old names still works.
# Domain for the optional Caddy profile (automatic HTTPS): docker compose --profile caddy up -d
BUGBERRY_DOMAIN=bugberry.kantor.com
# Host port for the app when Caddy is not used. It listens on localhost only; put your reverse proxy in
# front of it, or set BUGBERRY_BIND=0.0.0.0 to expose it directly.
BUGBERRY_PORT=3000
BUGBERRY_BIND=127.0.0.1
# Public domain for the "s3" profile's storage, served by Caddy (then S3_ENDPOINT=https://<this domain>)
# BUGBERRY_S3_DOMAIN=s3.bugberry.kantor.com

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Sign-in methods: each is optional, at least one must be on. Redirect URIs (set in each provider):
#   <APP_URL>/api/auth/callback/google   <APP_URL>/api/auth/callback/github   <APP_URL>/api/auth/callback/gitlab
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GitLab.com by default; set GITLAB_URL for a self-hosted GitLab
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.kantor.com
# Email sign-in codes: resend or smtp. Without it, codes are printed to the server log outside production; in production email sign-in is off without it.
# EMAIL_DRIVER=resend
# EMAIL_FROM=BugBerry <no-reply@kantor.com>
# RESEND_API_KEY=
# SMTP_HOST=smtp.kantor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# Unset: anyone can sign up. Set it to limit sign-in to your company domains.
# ALLOWED_EMAIL_DOMAINS=kantor.com
# Printed by `bun run key` in apps/extension
EXTENSION_ID=
# Optional: where "New report" sends people to install the extension (an http(s) URL)
# EXTENSION_INSTALL_URL=

# local keeps uploads in the "uploads" volume. For Cloudflare R2, AWS S3, MinIO or the "s3" profile use s3.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=fdebag
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_VIRTUAL_HOSTED_STYLE=false

MAX_UPLOAD_MB=300
UPLOAD_URL_TTL_SECONDS=3600
READ_URL_TTL_SECONDS=3600

# true when Caddy (profile caddy) or another reverse proxy sits in front of the client container.
# The nginx inside the client container is counted already.
TRUST_PROXY=false
